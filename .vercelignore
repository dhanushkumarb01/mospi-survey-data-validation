# What a Vercel deployment may contain (docs/VERCEL_REVIEW_ONLY_DEPLOYMENT.md).
# Allowlist: everything is excluded, then only the application code and the SYNTHETIC demo bundle are re-included.
# Raw PLFS folders, stored runs, audit trails, evaluation runs, EDA, notebooks, media, secrets and docs never upload.
/*
!/mospi/
!/data/
!/requirements.txt
!/pyproject.toml
!/vercel.json
!/deploy/

# Inside the allowed folders: only the SYNTHETIC demo bundle of data/ (no raw deliveries, stored runs, job records or evaluation output), no tests or caches.
/data/*
!/data/demo/
/*/runs/
# deploy/: only the PUBLIC CA certificate the hosted client uses to verify the database server (never a key).
/deploy/*
!/deploy/postgres/
/deploy/postgres/*
!/deploy/postgres/mospi-db-ca.crt
**/tests/
**/__pycache__/
*.py[cod]

# Never, anywhere (defence in depth; none of these belong in a deployment).
*.sqlite
*.sqlite3
*.db
*.db-*
*.csv
*.zip
*.xlsx
*.xls
*.sav
*.dta
*.log
users*.json
.env
.env.*
*.key
*.pem
*.p12
*.pfx
