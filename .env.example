# Copy to .env (git-ignored; excluded from Docker and Vercel uploads) and fill in. Never commit real values.
# docs/deployment/POSTGRESQL.md section 3 explains every value.

# Supabase admin connection (session pooler, port 5432): migrations, roles, registry, serving loads, backups. Never the web app.
MOSPI_DB_ADMIN_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=<absolute path>/deploy/supabase/prod-ca-2021.crt
MOSPI_SUPABASE_PROJECT_REF=<project-ref>
MOSPI_SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com
MOSPI_DB_CA_FILE=deploy/supabase/prod-ca-2021.crt

# Login role passwords (24+ characters), used by: python -m mospi.db.migrate --roles
MOSPI_DB_APP_PASSWORD=<generated>
MOSPI_DB_READER_PASSWORD=<generated>
# Optional: creates mospi_reviewer, the insert-only role that lets the hosted instance record decisions
# (docs/deployment/VERCEL_REVIEW_ONLY_DEPLOYMENT.md §4a). Leave unset and --roles does not create or change it.
MOSPI_DB_REVIEWER_PASSWORD=<generated>

# Local app and worker: mospi_app through the session pooler.
MOSPI_DATABASE_URL=postgresql://mospi_app.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Hosted reader through the transaction pooler (port 6543). Vercel receives this value as MOSPI_DATABASE_URL.
MOSPI_HOSTED_DATABASE_URL=postgresql://mospi_reader.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Optional: hosted decisions through the transaction pooler. Vercel receives it under the same name; without it the hosted
# instance stays read-only. The local app ignores it (kept here only for the one-off connection check in §4a step 3).
MOSPI_REVIEW_DATABASE_URL=postgresql://mospi_reviewer.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full

# sqlite (default) or postgres
MOSPI_AUDIT_BACKEND=sqlite

# Signs session cookies (32+ random characters; one value per instance, the hosted one set on Vercel too).
# Accounts live in the database (docs/deployment/USER_ACCOUNTS.md); the first administrator: python -m mospi.auth create-admin
MOSPI_SESSION_SECRET=<generated>

# Keyed hash for record-key overlap detection in uploads (never leaves this machine).
MOSPI_KEY_HMAC_SECRET=<generated>

# Vercel CLI deploys (never written to disk by the tools; keep it in the environment or here).
VERCEL_TOKEN=<token>
